{
  "name": "dsh-ai-workflow",
  "version": "0.1.0",
  "description": "ComfyUI-style AI workflow canvas for the DeepSeek Harness right sidebar: isolated agent members, exchange node, chat input/output nodes, a leader node that is the conversation itself, and ComfyUI workflows rendered and run in place.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "workflow.js",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "workflow",
    "agent",
    "canvas"
  ],
  "scripts": {
    "test": "node --test test/workflow.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "GPL-3.0-or-later"
}